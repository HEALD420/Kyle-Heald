# Copy this file to .env (or fill app.json -> expo.extra.etsyApiKey) and add your
# Etsy app's keystring. Get one at https://www.etsy.com/developers/your-apps
#
# Etsy OAuth 2.0 uses PKCE, so NO client secret is required for this mobile app.
# Only the public keystring (API key) is needed on the device.

ETSY_API_KEY=your_etsy_keystring_here
